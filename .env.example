# Create a read-only Notion connection and grant access to the content databases.
# Store real values only in .env.local and the hosting service environment.
# Never expose NOTION_TOKEN via NEXT_PUBLIC_ or commit a real token.
NOTION_TOKEN=

# Use data source IDs, not database IDs.
NOTION_NOTICES_DATA_SOURCE_ID=
NOTION_REPORTS_DATA_SOURCE_ID=

# Public Vercel Blob store for generated cover images only (Production).
# Vercel can inject this when the store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Random server-only secret (at least 32 characters), used by daily sync and
# the one-time Notion webhook setup. Never use NEXT_PUBLIC_ for these values.
CRON_SECRET=
NOTION_WEBHOOK_VERIFICATION_TOKEN=
