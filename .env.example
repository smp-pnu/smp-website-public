# Create a Notion connection and grant access to the content databases.
# Read-only is sufficient unless report metadata autofill is enabled.
# Store real values only in .env.local and the hosting service environment.
# Never expose NOTION_TOKEN via NEXT_PUBLIC_ or commit a real token.
NOTION_TOKEN=

# Use data source IDs, not database IDs.
NOTION_NOTICES_DATA_SOURCE_ID=
NOTION_REPORTS_DATA_SOURCE_ID=
NOTION_MEMBERS_DATA_SOURCE_ID=

# Public Vercel Blob store for generated covers (Production).
# Vercel can inject this when the store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Random server-only secret (at least 32 characters), used by daily sync and
# the one-time Notion webhook setup. Never use NEXT_PUBLIC_ for these values.
CRON_SECRET=
NOTION_WEBHOOK_VERIFICATION_TOKEN=
# Temporarily enable only during an administrator-supervised Notion handshake.
# Disable immediately after installing the verification token.
NOTION_WEBHOOK_SETUP_ENABLED=false

# Optional school-owned Apps Script web app. Credentials stay in Script
# Properties; this URL contains no secret. See docs/drive-cleanup.md.
DRIVE_CLEANUP_WEB_APP_URL=

# Opt-in: requires Update content capability and metadata schema setup.
# Only the report data source is writable by the metadata worker.
NOTION_METADATA_WRITE_ENABLED=false
