{
  "name": "smp-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "predev": "node scripts/prepare-pdf.mjs && node scripts/prepare-backgrounds.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-pdf.mjs && node scripts/prepare-backgrounds.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --conditions=react-server --test tests/*.test.ts",
    "test:bundles": "node scripts/check-read-bundles.mjs",
    "build:free:fixture": "node scripts/build-free.mjs --fixture",
    "build:free": "node scripts/build-free.mjs",
    "deploy:free": "node scripts/deploy-free.mjs",
    "publish:free": "node --import tsx --conditions=react-server free/jobs/publish.ts",
    "seed:free:fixture": "node --import tsx --conditions=react-server free/jobs/seed-fixture.ts",
    "test:free:http": "node tests/free-http.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/noto-sans-kr": "5.3.0",
    "@napi-rs/canvas": "1.0.10",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-pdf": "11.0.0",
    "react-router": "7.18.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vite": "8.3.3",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
